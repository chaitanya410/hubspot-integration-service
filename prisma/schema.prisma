// Prisma schema for the HubSpot Integration Service
//
// Default provider is SQLite for a zero-setup local dev experience
// (see README "Database" section for how/why, and how to swap to
// PostgreSQL for a persistent production deployment).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

/// A connected HubSpot account (one row per installed OAuth app instance).
/// Single-tenant by default for this assignment, but hubId is unique so the
/// model already supports multiple connected portals if this service grows
/// into a multi-tenant one.
model Account {
  id           String   @id @default(uuid())
  hubId        Int      @unique
  accessToken  String
  refreshToken String
  expiresAt    DateTime
  scopes       String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Local mirror of a HubSpot CRM Contact.
model Contact {
  id               String   @id @default(uuid())
  hubspotId        String   @unique
  email            String?
  firstName        String?
  lastName         String?
  phone            String?
  company          String?
  lifecycleStage   String?
  hubspotCreatedAt DateTime?
  hubspotUpdatedAt DateTime?
  archived         Boolean  @default(false)
  raw              String // full HubSpot properties payload, as JSON text
  syncedAt         DateTime @default(now())
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([email])
  @@index([lifecycleStage])
}

/// Local mirror of a HubSpot CRM Deal.
model Deal {
  id               String    @id @default(uuid())
  hubspotId        String    @unique
  dealName         String?
  amount           Float?
  dealStage        String?
  pipeline         String?
  closeDate        DateTime?
  hubspotCreatedAt DateTime?
  hubspotUpdatedAt DateTime?
  archived         Boolean   @default(false)
  raw              String
  syncedAt         DateTime  @default(now())
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([dealStage])
  @@index([pipeline])
}

/// Raw record of every webhook event HubSpot has sent us, kept for
/// auditability/debugging and to make processing idempotent (eventId unique).
model WebhookEvent {
  id               String    @id @default(uuid())
  eventId          String    @unique
  subscriptionType String
  objectId         String
  occurredAt       DateTime?
  changeSource     String?
  payload          String
  processed        Boolean   @default(false)
  processingError  String?
  receivedAt       DateTime  @default(now())
}

/// History of sync runs, surfaced via GET /sync/runs for observability.
model SyncRun {
  id            String    @id @default(uuid())
  entityType    String
  status        String // "running" | "success" | "failed"
  recordsSynced Int       @default(0)
  pagesFetched  Int       @default(0)
  error         String?
  startedAt     DateTime  @default(now())
  finishedAt    DateTime?
}
