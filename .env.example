# Copy this file to .env and fill in your own values.
# See README.md > "Setup" for how to obtain HubSpot credentials.

# --- Server ---
PORT=3000
NODE_ENV=development
# Base URL this service is reachable at (used to build the OAuth redirect_uri).
# Use your cloudflared/Render/Vercel URL in non-local environments.
BASE_URL=http://localhost:3000

# --- Database ---
# PostgreSQL connection string. Any Postgres works (local, Docker,
# Neon/Supabase/Render Postgres, or Vercel's Prisma Postgres integration -
# see README > Deployment). Example:
# DATABASE_URL="postgresql://user:password@host:5432/dbname?sslmode=require"
DATABASE_URL=

# --- HubSpot App credentials ---
# From your HubSpot developer account > Apps > (your app) > Auth
HUBSPOT_CLIENT_ID=
HUBSPOT_CLIENT_SECRET=
# Must exactly match a Redirect URL configured on the app
HUBSPOT_REDIRECT_URI=http://localhost:3000/auth/hubspot/callback
# Space-separated scopes requested during OAuth install
HUBSPOT_SCOPES="crm.objects.contacts.read crm.objects.contacts.write crm.objects.deals.read crm.objects.deals.write"

# --- HubSpot Webhooks ---
# Same client secret is used to validate the X-HubSpot-Signature-v3 header,
# so HUBSPOT_CLIENT_SECRET above is reused there too.
# Only needed if you use scripts/register-webhook.ts to create the
# subscription via the Webhooks Management API (requires a developer API key
# from https://app.hubspot.com/l/developer-api-key, NOT the OAuth token).
HUBSPOT_DEVELOPER_API_KEY=
HUBSPOT_APP_ID=
WEBHOOK_TARGET_URL=http://localhost:3000/webhooks/hubspot

# --- Background sync (bonus) ---
ENABLE_SCHEDULED_SYNC=false
SYNC_INTERVAL_MINUTES=30

# --- Logging ---
LOG_LEVEL=info
